# Set one or both keys.
# OpenCode Go API key (https://opencode.ai/console)
OPENCODE_API_KEY=oc_sk_your_key_here
# OpenRouter API key (https://openrouter.ai/keys). When set, its model is the default.
# OPENROUTER_API_KEY=                   (paste the whole key, it starts with sk-or-v1-)
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_PROVIDER=baidu/fp8          (comma list; empty = let OpenRouter choose)
# OPENROUTER_ALLOW_FALLBACKS=false       (true = other providers may serve it if these are down)
# OPENROUTER_MODELS=                     (extra OpenRouter models for the picker, comma list)
# Optional
# DEFAULT_MODEL=deepseek-v4.1-flash
# PORT=5173
# HOST=127.0.0.1
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
