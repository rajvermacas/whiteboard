# Set one or more keys. Every provider with a key appears in the picker.
# OpenCode Go API key (https://opencode.ai/console)
OPENCODE_API_KEY=oc_sk_your_key_here
# OpenGateway API key (https://opengateway.ai). When set, its model is the default.
# OPENGATEWAY_API_KEY=apik_your_key_here
# OPENGATEWAY_MODEL=deepseek/deepseek-v4.1-flash-eco   (the default; all its active chat models are listed)
# OPENGATEWAY_API_BASE=https://apis.opengateway.ai/v1
# OpenRouter API key (https://openrouter.ai/keys). When set, its model is the default.
# OPENROUTER_API_KEY=                   (paste the whole key, it starts with sk-or-v1-)
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_PROVIDER=baidu/fp8          (comma list; empty = let OpenRouter choose)
# OPENROUTER_ALLOW_FALLBACKS=false       (true = other providers may serve it if these are down)
# OPENROUTER_MODELS=                     (extra OpenRouter models for the picker, comma list)
# Tavily API key (https://tavily.com), optional: reads pages and searches the web for links in your messages
# TAVILY_API_KEY=
# Optional
# LINK_FETCH=off     # don't read links in messages
# WEB_SEARCH=off     # don't search the web before answers
# DEFAULT_MODEL=glm-5.3
# PORT=5173
# HOST=127.0.0.1
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
